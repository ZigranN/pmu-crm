# Local development only. Replace placeholders locally; never commit real keys.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://pmu:local-only@127.0.0.1:5432/pmu_dev
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-before-use
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
