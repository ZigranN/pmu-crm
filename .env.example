# TEST_DATABASE_URL=postgresql://pmu_test:local-only@127.0.0.1:5433/pmu_test

# Seed links an already registered user; it does not create passwords.
SEED_STUDIO_NAME="Local studio"
SEED_STUDIO_SLUG="local-studio"
SEED_STUDIO_COUNTRY="Italy"
SEED_STUDIO_CITY="Sellia Marina"
